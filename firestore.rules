rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lista blanca de administradores reales del ERP.
    // Debe reflejar exactamente ROLE_ASSIGNMENTS en src/services/domain/userProfileService.ts.
    // Cualquier usuario de Firebase Auth que NO esté aquí (p.ej. una cuenta autorregistrada, o
    // una alumna con el token que le da studentLogin) no obtiene permiso de escritura en las
    // colecciones del ERP, sin importar el rol que su propio perfil declare.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['raulfdz3@gmail.com', 'info@xendance.space'];
    }

    // ============================================================
    // xds-erp (panel de gestión interno, mismo proyecto de Firebase)
    // ============================================================

    // Reglas específicas para solicitudes de cambio de datos
    match /changeRequests/{requestId} {
      // Solo la propia alumna autenticada puede crear una solicitud sobre SU PROPIO studentId --
      // antes "if true" dejaba crear una solicitud para el studentId de CUALQUIER otra alumna
      // desde la consola del navegador (sin ni siquiera iniciar sesión), y el admin aprobaba
      // confiando ciegamente en el "antes"/"después" que venía en la propia solicitud: una vía
      // real de secuestrar el email/teléfono de otra persona.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentId;
      // Cualquiera puede LEER (para que los estudiantes vean sus solicitudes)
      allow read: if true;
      // Solo administradores pueden ACTUALIZAR (aprobar/rechazar)
      allow update, delete: if isAdmin();
    }

    // Reglas para progreso de estudiantes (gamificación)
    match /studentProgress/{progressId} {
      // Cualquiera puede LEER (los rankings/insignias no son sensibles)
      allow read: if true;
      // Crear: la propia alumna autenticada inicializando su progreso al entrar por primera vez
      // al Portal, O un admin (updateProgressAfterAttendance crea el documento la primera vez que
      // se pasa lista a esa alumna, bajo la sesión del admin, no la suya). Antes "if true" dejaba
      // forjar puntos/nivel/insignias de cualquier alumna sin iniciar sesión.
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == progressId);
      // Solo administradores pueden ACTUALIZAR/ELIMINAR
      allow update, delete: if isAdmin();
    }

    // Avisos de ausencia a una clase concreta (Portal de Alumno). Cada alumna solo puede crear un
    // aviso sobre sí misma; puede borrar los suyos si cambia de idea; el admin puede gestionarlos
    // todos. La lectura es pública porque el Dashboard del ERP los lista sin pasar por sesión de
    // alumna (igual que el resto de colecciones de esta sección).
    match /classAbsences/{absenceId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentId;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.studentId);
      allow update: if isAdmin();
    }

    // Suscripciones push del Portal de Alumno (Web Push), una por alumna, id == studentId. Solo
    // la propia alumna puede crear/actualizar la suya (nunca la de otra); el admin (o las Cloud
    // Functions con el SDK admin, que ignoran estas reglas) son quienes la leen para enviar avisos.
    match /studentPushSubscriptions/{studentId} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == studentId;
    }

    // Perfiles de usuario: cada uno puede crear el suyo propio, pero nunca con rol elevado
    // (eso evita que una cuenta autorregistrada se autoasigne 'Admin'/'SuperAdmin').
    // Solo un administrador ya reconocido puede cambiar roles.
    match /userProfiles/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && !(request.resource.data.role in ['SuperAdmin', 'Admin']);
      allow update, delete: if isAdmin();
    }

    // Alumnas: antes el documento principal era público de lectura porque el Portal de Alumno
    // buscaba su propia ficha con una query where('phone','==',...) sin sesión. Ya no hace falta:
    // el login (Cloud Function studentLogin) emite un token real de Firebase Auth y el Portal lee
    // su ficha directamente por id ya autenticada, así que puede restringirse igual que la
    // subcolección de abajo -- solo un admin, o la propia alumna (uid == studentId), puede leer
    // cualquier ficha de alumna. Antes cualquier visitante sin sesión podía listar/leer el nombre,
    // teléfono, email, fecha de nacimiento y notas de TODAS las alumnas directamente contra
    // Firestore (sin pasar por la app), aunque la UI nunca lo permitiera.
    match /students/{studentId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == studentId);
      allow write: if isAdmin();

      match /private/{doc} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == studentId);
        allow write: if isAdmin();
      }
    }

    // Resto de colecciones de nivel superior del ERP: de lectura pública (necesario para el
    // Portal de Alumno, que no siempre tiene sesión) y escritura solo para administradores reales
    // (isAdmin()) -- NO simplemente "cualquier usuario autenticado". Esto es intencional: este
    // proyecto de Firebase también da sesión a alumnas (studentLogin) y, en otro proyecto que
    // comparte este mismo Firebase (xds-web-next, la web pública, ver más abajo), a su propio
    // admin -- "autenticado" no implica "administradora del ERP", así que un allow write más
    // amplio que isAdmin() dejaría a una alumna o al admin de la web pública editar pagos,
    // cuotas, asistencia, etc.
    // IMPORTANTE: se enumeran explícitamente (en vez de usar un comodín /{document=**}) porque
    // un comodín recursivo también haría público el contenido de students/{id}/private de arriba
    // — Firestore evalúa TODAS las reglas que apliquen a una ruta con OR, así que una regla
    // pública en cualquier sitio bastaría para filtrar los datos que acabamos de restringir.
    match /instructors/{id} { allow read: if true; allow write: if isAdmin(); }
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /payments/{id} { allow read: if true; allow write: if isAdmin(); }
    match /costs/{id} { allow read: if true; allow write: if isAdmin(); }
    match /events/{id} { allow read: if true; allow write: if isAdmin(); }
    match /nuptialDances/{id} { allow read: if true; allow write: if isAdmin(); }
    match /merchandiseItems/{id} { allow read: if true; allow write: if isAdmin(); }
    match /merchandiseSales/{id} { allow read: if true; allow write: if isAdmin(); }
    match /attendance/{id} { allow read: if true; allow write: if isAdmin(); }
    match /activityLogs/{id} { allow read: if true; allow write: if isAdmin(); }

    // Tareas y planificación del equipo (apartado Calendario del ERP). A diferencia del resto de
    // colecciones de arriba, NO son de lectura pública: el Portal de Alumno no las necesita, así
    // que solo un administrador real puede leerlas o escribirlas.
    match /calendarTasks/{id} { allow read, write: if isAdmin(); }

    // ============================================================
    // xds-web-next (web pública de marketing, mismo proyecto de Firebase)
    // ============================================================

    // La web crea leads aquí; /panel (login real de Firebase Auth) los lee. Nadie puede editar ni
    // borrar un lead desde el cliente, esté autenticado o no.
    match /enrollments/{doc} {
      allow create: if true;
      // isAdmin() en vez de "cualquier autenticado": este proyecto también da sesión a alumnas
      // del Portal (studentLogin) -- sin esto, cualquier alumna logueada podría leer los leads
      // de matrícula/pedidos/contacto de la web pública.
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /orders/{doc} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /messages/{doc} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Contenido público de la web, editable desde /panel. Lectura pública porque la propia web
    // renderiza estos datos sin sesión.
    // NOTA: "siteEvents", no "events" -- el ERP ya tiene su propia colección "events" real
    // (competiciones/exhibiciones con participantes, precio de entrada y fotos); esta es el
    // contenido de marketing de la página pública /eventos y nunca debe compartir ese nombre.
    match /siteEvents/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /blogPosts/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /partners/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{doc} { allow read: if true; allow write: if isAdmin(); }

    // Todo lo demás queda bloqueado por defecto para el cliente (el SDK admin de las Cloud
    // Functions ignora las reglas igualmente). Antes de abrir una colección nueva aquí, decidir
    // explícitamente a qué proyecto pertenece y con qué función (isAdmin() vs propio uid vs
    // pública) -- ver los bloques de arriba como referencia.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
